# Ollama Configuration (for local embeddings and chat)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2  # Main chat model for conversations
OLLAMA_EMBEDDING_MODEL=embeddinggemma  # Embedding model for vector search

# PostgreSQL Database Configuration
POSTGRES_DB=pdf_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Authentication method (trust, md5, scram-sha-256)
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# PgAdmin Configuration (Optional - for database administration)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin_password_here
PGADMIN_PORT=8080

# Database Connection URL (for application use)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Vector Database Configuration
VECTOR_DIMENSION=768  # Dimension for embeddinggemma model
EMBEDDING_MODEL=embeddinggemma

# Application Environment
NODE_ENV=development